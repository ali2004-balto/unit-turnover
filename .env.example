# Every setting the app reads. Locally, copy this file to .env.local and fill in
# only what you need (nothing, to try it with demo data). In production, enter
# them in the Vercel project's settings (see docs/deploy.md).
# Never commit real values: keys and passwords belong in .env.local or Vercel only.

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for local development: the app uses an embedded Postgres stored
# in .data/pglite, with demo data loaded on first run.
# In production, set it to Supabase's "Transaction pooler" connection string,
# e.g. postgresql://postgres.xxxx:password@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: where the local embedded database is kept (default .data/pglite).
PGLITE_DATA_DIR=

# ── The app's address ───────────────────────────────────────────────────────
# Used in the links people get by text and email, e.g. https://turnover.example.com
# Required in production. Leave empty locally (it's taken from the browser's address).
APP_URL=

# ── First-time setup ────────────────────────────────────────────────────────
# Any long random text. With it set, /setup lets you create the first manager
# on a new server. Remove it once you've signed in.
SETUP_TOKEN=

# ── Photos and files ────────────────────────────────────────────────────────
# Production: Supabase Storage. The service key is secret (server only): it
# goes in Vercel's settings, never in the browser or the code. The private
# bucket is created on the first deploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the bucket's name (default "files").
SUPABASE_BUCKET=

# Development: where uploads are kept when Supabase isn't set up (default .data/uploads).
FILES_DIR=

# ── Texts and emails ────────────────────────────────────────────────────────
# "dry-run" (the default): nothing is sent; every message shows in full in
# Settings > Messages, links included. "live": texts go through Twilio and
# email through Resend, with the keys below.
NOTIFICATIONS_MODE=dry-run

# Twilio: Account SID and Auth Token from the Twilio console, and the number
# texts come from (+16045550123) or a messaging service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Resend: an API key, and the sender on a domain you've verified in Resend,
# e.g. Unit Turnover <turnover@yourcompany.com>
RESEND_API_KEY=
EMAIL_FROM=

# ── Scheduled work ──────────────────────────────────────────────────────────
# Any long random text. Vercel's scheduler sends it to /api/cron/tick every
# 5 minutes (morning reminders, texts held overnight, retries). Required in production.
CRON_SECRET=

# Optional: "1" runs that work inside the server every minute instead (for a
# server that isn't on Vercel); "0" turns it off in development.
IN_PROCESS_TICK=
